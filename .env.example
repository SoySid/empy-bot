# Configuración general y WhatsApp
GROUP_JID="120363000000000000@g.us" # ID obligatorio del grupo de WhatsApp objetivo (fail-closed: si no se configura, no procesa mensajes)
BOT_PREFIX="!"
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# APIs de Inteligencia Artificial (LLM & Embeddings)
